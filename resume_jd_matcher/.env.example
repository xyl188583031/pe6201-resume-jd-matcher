# Copy this file to `.env` and fill in a key only if you want live runs.
#
# The whole pipeline runs offline with RJD_OFFLINE=1 (see README.md), so the
# key is NOT required to reproduce the wiring, the form matrix, the browser
# checks, or the unit tests.  It is required only for `eval/run_eval.py --live`.
#
# Never commit the real `.env` — it is listed in .gitignore.

OPENROUTER_API_KEY=
